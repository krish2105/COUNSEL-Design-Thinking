# COUNSEL — zero paid inference. Every key below is a FREE tier or nothing.
# Copy to .env. Never commit .env.

# --- Local inference (preferred, free, no key) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3:567m

# --- Free cloud fallbacks, used when Ollama is unreachable (i.e. deployed) ---
# https://aistudio.google.com/apikey  — free tier, no card
GEMINI_API_KEY=
# https://console.groq.com/keys — free tier, no card
GROQ_API_KEY=

# Present but HARD-OFF. Setting this does NOT enable Anthropic; a test enforces that.
ANTHROPIC_API_KEY=

# --- Quotas, counted as REQUESTS, not tokens ---
QUOTA_GEMINI_REQUESTS=200
QUOTA_GROQ_REQUESTS=200
QUOTA_SESSION_REQUESTS=120

# --- Search ---
SEARXNG_URL=http://localhost:8888

# --- Storage ---
COUNSEL_DB=./data/counsel.db
